{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*",
    "functions/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib/**/*",
    "lib",
    "test"
  ]
}
