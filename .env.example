# DairyFarm Portal - Environment Configuration Template
# In Cloudflare Pages, configure these under Settings > Environment variables or using:
#   npx wrangler pages secret put <KEY> --project-name=dairy-farm-portal
# In GitHub Actions (CI/CD), configure these under Settings > Secrets and variables > Actions

# 1. Cloudflare Deployment Secrets (GitHub Actions Secrets)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# 2. Application Secrets (Cloudflare Pages Secrets)
# Secret key used for signing and verifying JWT tokens (HMAC-SHA256)
JWT_SECRET_KEY=

# Internal microservice parser URL and authorization token
PARSER_SERVICE_URL=
PARSER_SECRET_TOKEN=
